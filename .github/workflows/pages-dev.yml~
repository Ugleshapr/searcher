name: Pages (dev under /dev)
on:
  push:
    branches: [ dev ]
permissions:
  contents: read
  pages: write
  id-token: write
concurrency:
  group: pages-dev
  cancel-in-progress: true

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      # 1) Вытаскиваем main в site/
      - name: Checkout main into site/
        uses: actions/checkout@v4
        with:
          ref: main
          path: site

      # 2) Вытаскиваем dev в dev-src/
      - name: Checkout dev into dev-src/
        uses: actions/checkout@v4
        with:
          ref: dev
          path: dev-src

      # 3) Кладём dev-сайт в подпапку /dev (не трогая корень из main)
      - name: Copy dev into /dev
        run: |
          mkdir -p site/dev
          rsync -a --delete dev-src/ site/dev/

      
      - uses: actions/upload-pages-artifact@v3
        with:
          path: site
      - uses: actions/deploy-pages@v4

